local BG = {Ready = false, Done = false, Assets = {}, Entries = {}, Start = os.clock()}

local function FileIsGood(name, size)
	if type(isfile) ~= "function" then return false end
	local okF, exists = pcall(isfile, name)
	if not (okF and exists) then return false end
	if type(readfile) ~= "function" then return true end
	local okR, cur = pcall(readfile, name)
	return okR and type(cur) == "string" and #cur == size
end

task.spawn(function()
	local getAsset = getcustomasset or getsynasset
	if CONFIG.BackgroundVideo and getAsset and type(writefile) == "function" then
		pcall(function()
			local name = "ll_maki_gate4.jpg"
			if not FileIsGood(name, MAKI_SIZE) then writefile(name, b64decode(MAKI_B64, 15000)) end
			BG.MakiAsset = getAsset(name)
		end)
		local ok = pcall(function()
			for n, data in ipairs(FRAMES.sheets) do
				local name = "ll_gojo7_s" .. n .. ".jpg"
				if not FileIsGood(name, FRAMES.sizes[n]) then
					writefile(name, b64decode(data, 15000))
				end
				BG.Assets[n] = getAsset(name)
			end
		end)
		BG.Ready = ok and #BG.Assets == #FRAMES.sheets
	end
	BG.Done = true
end)

local function BuildLayers(e)
	local scale = math.max(e.w / FRAMES.fw, e.h / FRAMES.fh)
	e.labels = {}
	for n = 1, #FRAMES.sheets do
		e.labels[n] = New("ImageLabel", {Name = "Sheet" .. n, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(math.ceil(FRAMES.fw * scale), math.ceil(FRAMES.fh * scale)), BackgroundTransparency = 1,
			BorderSizePixel = 0, Image = BG.Assets[n], ImageTransparency = 0, ImageRectSize = Vector2.new(FRAMES.fw - 2, FRAMES.fh - 2),
			ZIndex = e.z}, e.holder)
	end
	task.spawn(function() pcall(function() ContentProvider:PreloadAsync(e.labels) end) end)
end

-- the current sheet AND the next one stay visible (next one sits underneath), so a sheet is always
-- already loaded before it is shown. This is what removes the black flash.
local function SetSheets(e, cur)
	local count = #FRAMES.sheets
	local n1 = cur % count + 1
	local n2 = n1 % count + 1
	for n, l in ipairs(e.labels) do
		if n == cur then
			l.ImageTransparency = 0
			l.ZIndex = e.z + 3
		elseif n == n1 then
			l.ImageTransparency = 0
			l.ZIndex = e.z + 2
		elseif n == n2 then
			l.ImageTransparency = 0
			l.ZIndex = e.z + 1
		else
			l.ImageTransparency = 1
			l.ZIndex = e.z
		end
	end
end

RunService.RenderStepped:Connect(function()
	local idx = math.floor((os.clock() - BG.Start) * FRAMES.fps) % FRAMES.frames
	local sheet = math.floor(idx / FRAMES.per) + 1
	local inSheet = idx % FRAMES.per
	local off = Vector2.new((inSheet % FRAMES.cols) * FRAMES.fw + 1, math.floor(inSheet / FRAMES.cols) * FRAMES.fh + 1)
	for i = #BG.Entries, 1, -1 do
		local e = BG.Entries[i]
		if not e.holder.Parent then
			table.remove(BG.Entries, i)
		else
			if BG.Ready and not e.labels then BuildLayers(e) end
			if e.labels then
				if e.sheet ~= sheet then
					e.sheet = sheet
					SetSheets(e, sheet)
				end
				local cur = e.labels[sheet]
				cur.ImageRectOffset = off
				-- keep the animated fallback underneath until the video texture is really on screen
				if e.fallback and cur.IsLoaded and e.labels[sheet % #FRAMES.sheets + 1].IsLoaded then
					e.loadedFrames = (e.loadedFrames or 0) + 1
					if e.loadedFrames > 6 then e.fallback:Destroy() e.fallback = nil end
				end
			end
		end
	end
end)

-- background: embedded video frames, or an animated gradient + particles while loading / if unsupported
local function BuildBackground(parent, zindex, w, h, noVideo)
	local holder = New("Frame", {Name = "BG", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(8, 6, 10),
		BorderSizePixel = 0, ClipsDescendants = true, ZIndex = zindex or 1}, parent)

	local fb = New("Frame", {Name = "Fallback", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
		ZIndex = zindex or 1}, holder)
	local grad = New("Frame", {Size = UDim2.fromScale(2, 2), Position = UDim2.fromScale(-0.5, -0.5),
		BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = zindex or 1}, fb)
	local ug = New("UIGradient", {Rotation = 0}, grad)
	OnAccent(function(c)
		ug.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(8, 4, 8)),
			ColorSequenceKeypoint.new(0.5, c:Lerp(Color3.new(0, 0, 0), 0.65)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(8, 4, 8)),
		})
	end)
	task.spawn(function()
		while grad.Parent do
			ug.Rotation = (os.clock() * 12) % 360
			task.wait(1 / 30)
		end
	end)
	for i = 1, 14 do
		local size = math.random(3, 7)
		local p = New("Frame", {Size = UDim2.fromOffset(size, size), BackgroundColor3 = WHITE, BackgroundTransparency = 0.6,
			BorderSizePixel = 0, Position = UDim2.fromScale(math.random(), math.random()), ZIndex = (zindex or 1) + 1}, fb)
		Corner(p, 8)
		OnAccent(function(c) p.BackgroundColor3 = c end)
		task.spawn(function()
			while p.Parent do
				local t = math.random(40, 90) / 10
				local tw = Tween(p, t, {Position = UDim2.fromScale(math.random(), math.random()),
					BackgroundTransparency = math.random(40, 90) / 100}, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				tw.Completed:Wait()
			end
		end)
	end

