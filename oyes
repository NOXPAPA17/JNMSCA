	local function findPeopleContainer()
	    local function searchForPeople(parent)
	        if not parent then return nil end
	        for _, child in ipairs(parent:GetChildren()) do
	            if child.Name == "People" and (child:IsA("Frame") or child:IsA("ScrollingFrame")) then
	                return child
	            end
	            if #child:GetChildren() > 0 then
	                local result = searchForPeople(child)
	                if result then return result end
	            end
	        end
	        return nil
	    end
	    return searchForPeople(CoreGui)
	end

	local function destroyPlayerCard(player)
	    if not player then return false end
	    local people = findPeopleContainer()
	    if not people then return false end
	    local destroyed = false
	    for _, child in ipairs(people:GetChildren()) do
	        local hasPlayerName = false
	        for _, d in ipairs(child:GetDescendants()) do
	            if d:IsA("TextLabel") or d:IsA("TextButton") then
	                local text = tostring(d.Text or "")
	                if text == player.Name or text == player.DisplayName then
	                    hasPlayerName = true
	                    break
	                end
	            end
	        end
	        if hasPlayerName then
	            pcall(function() child:Destroy() destroyed = true end)
	        end
	    end
	    return destroyed
	end

	local function findPlayerEntryInPlayerList(player)
	    if not player then return nil end
	    local targetName = "PlayerEntry_" .. player.UserId
	    local playerList = CoreGui:FindFirstChild("PlayerList")
	    if not playerList then return nil end
	    local function searchForEntry(parent)
	        for _, child in ipairs(parent:GetChildren()) do
	            if child.Name == targetName then return child end
	            if #child:GetChildren() > 0 then
	                local result = searchForEntry(child)
	                if result then return result end
	            end
	        end
	        return nil
	    end
	    return searchForEntry(playerList)
	end

	local function hidePlayerInPlayerList(player)
	    if not player then return false end
	    local entry = findPlayerEntryInPlayerList(player)
	    if not entry then return false end
	    pcall(function()
	        entry.Visible = false
	        hiddenEntries[player.UserId] = entry
	    end)
	    return true
	end

	local function restorePlayerInPlayerList(userId)
	    if not userId then return end
	    local entry = hiddenEntries[userId]
	    if entry then
	        pcall(function() if entry and entry.Parent then entry.Visible = true end end)
	        hiddenEntries[userId] = nil
	    end
	end

	local function startContinuousHiding(player)
	    if not player then return end
	    local userId = player.UserId
	    removeTasks[userId] = nil
	    task.spawn(function()
	        while bannedPlayers[userId] or bannedAllList[userId] do
	            destroyPlayerCard(player)
	            hidePlayerInPlayerList(player)
	            task.wait(0.3)
	        end
	    end)
	end

